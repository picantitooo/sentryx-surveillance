# Configuración del backend de Valentino. No copiar credenciales al frontend público.
# hybrid: VadCLIP abre/cierra la alerta y VideoMAE la clasifica (requiere modelo/vadclip). videomae: EN-4.
SENTRIX_PREDICTOR=hybrid
# Ajustes del híbrido (vacío = valores del runner en modelo/vadclip/metadata.json)
SENTRIX_VADCLIP_ROOT=
SENTRIX_HYBRID_THRESHOLD=
SENTRIX_HYBRID_RELEASE=
SENTRIX_HYBRID_MERGE_GAP=
SENTRIX_HYBRID_MAX_EVENT_SECONDS=
SENTRIX_PROVIDER=cuda
SENTRIX_VIDEO_TRANSPORT=rtsp

# Servidor activo de Gabriel; ID del panel y ruta MediaMTX son distintos.
SENTRIX_SOURCE_ID=camara1
SENTRIX_CAMERA_NAME=Gabriel
SENTRIX_STREAM_PATH=camera01
SENTRIX_RTSP_PROTOCOL=rtsp
SENTRIX_RTSP_HOST=184.194.94.182
SENTRIX_RTSP_PORT=8554
SENTRIX_RTSP_USER=viewer

# La clave de control debe coincidir con INFERENCE_API_KEY en SvelteKit.
SENTRIX_CONTROL_API_KEY=

# Autenticación de la API (rol all o api): api_key, both (transición) o clerk. Los workers siempre usan api_key.
SENTRIX_AUTH_MODE=api_key
# Solo con both o clerk. Secretos: nunca en el frontend.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# URL de la instancia, sin barra final, por ejemplo https://mi-app.clerk.accounts.dev
CLERK_ISSUER=
# Orígenes exactos del panel, separados por coma (se comparan con el claim azp).
CLERK_AUTHORIZED_PARTIES=
# Página del panel que acepta la invitación.
CLERK_INVITATION_REDIRECT_URL=

# Solo completar si se configura otro servidor con autenticacion o RTSPS.
SENTRIX_RTSP_PASSWORD=
SENTRIX_RTSP_SHA256=

TA2_QUEUE_SIZE=2

# Solo sin SENTRIX_DATABASE_URL (pruebas locales): archivos SQLite de detecciones y logs.
SENTRIX_DETECTION_DB=
SENTRIX_LOG_DB=

# EN-4: thresholds provisionales por clase (JSON). Vacío usa .50/.60/.60/.55.
# SENTRIX_ALERT_THRESHOLDS={"Hurto":0.50,"Robo":0.60,"Agresión física":0.60,"Vandalismo":0.55}
SENTRIX_ALERT_THRESHOLDS=

# Conexión principal: detecciones, alertas, logs y cámaras en PostgreSQL.
SENTRIX_DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require&channel_binding=require

# Orígenes permitidos si el navegador consulta directamente la API.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://sentrix-vercel-upload.vercel.app

# Escalamiento horizontal: all (un proceso), api, worker o inference. Ver README.
SENTRIX_ROLE=all
# Servidor de inferencia compartido (vacío = cada worker carga los modelos). Solo con SENTRIX_PREDICTOR=hybrid.
SENTRIX_INFERENCE_URL=
# Clave para llamarlo; vacío = SENTRIX_CONTROL_API_KEY
SENTRIX_INFERENCE_API_KEY=
# Carpeta del modelo VideoMAE (vacío = modelo/)
SENTRIX_MODEL_ROOT=
SENTRIX_WORKER_CAPACITY=2
SENTRIX_LEASE_TTL=15
SENTRIX_COORDINATION_INTERVAL=2

# Retención (rol all o api): borra detecciones Normal que no pertenecen a una alerta y logs
# inference_completed con más de N días. 0 la desactiva. Intervalo entre limpiezas en segundos.
SENTRIX_RETENTION_DAYS=7
SENTRIX_RETENTION_INTERVAL=3600

# Clips de eventos (workers graban; la API firma URLs). Sin las variables del bucket quedan en disco.
SENTRIX_CLIPS=1
SENTRIX_CLIPS_DIR=
SENTRIX_CLIP_PRE_ROLL=5
SENTRIX_CLIP_POST_ROLL=2
SENTRIX_CLIP_MAX_SECONDS=300
SENTRIX_CLIP_URL_SECONDS=600
# Bucket S3 compatible (Cloudflare R2): endpoint https://<cuenta>.r2.cloudflarestorage.com
SENTRIX_CLIPS_S3_ENDPOINT=
SENTRIX_CLIPS_BUCKET=
SENTRIX_CLIPS_ACCESS_KEY_ID=
SENTRIX_CLIPS_SECRET_ACCESS_KEY=
# Tope de espacio de clips en el bucket (GB, 0 = sin tope). Al pasarlo, la API borra los más antiguos
# hasta quedar en PURGE_TARGET del tope. El bucket debe ser exclusivo de clips. R2 gratis = 10 GB.
SENTRIX_CLIPS_MAX_GB=8
SENTRIX_CLIPS_PURGE_TARGET=0.8
SENTRIX_CLIPS_PURGE_INTERVAL=300
